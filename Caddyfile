{
	admin off
	auto_https off
	persist_config off
}

(privacy) {
	header {
		?Cache-Control "no-store"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "accelerometer=(), autoplay=(), bluetooth=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), serial=(), usb=(), xr-spatial-tracking=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; manifest-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'; form-action 'none'; connect-src 'self' https://api.dropboxapi.com https://content.dropboxapi.com https://graph.microsoft.com https://login.microsoftonline.com https://*.1drv.com https://*.microsoftpersonalcontent.com https://*.sharepoint.com; frame-src 'self' https://login.microsoftonline.com"
		-Server
	}
}

:{$PORT:4000} {
	root * {$SITE_ROOT:dist}
	encode zstd gzip
	import privacy
	@immutable path_regexp immutable ^/assets/.+-[A-Za-z0-9_-]{8,}\.(js|css|wasm)$
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	rewrite /health /health.json
	rewrite /security /security.html
	rewrite /oauth/dropbox /oauth/dropbox.html
	rewrite /oauth/onedrive /oauth/onedrive.html
	file_server
	handle_errors {
		import privacy
		header Cache-Control "no-store"
		respond "{err.status_text}" {err.status_code}
	}
}
