{
  "name": "marknotes-web-assets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4000",
    "build": "tsc --noEmit && vite build && node build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4000",
    "serve": "caddy run --config ../Caddyfile --adapter caddyfile",
    "contracts": "node --test server-tests/*.test.mjs",
    "check": "prettier --check . && tsc --noEmit && eslint . && vitest run",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "parity": "vitest run --config vitest.parity.config.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.0.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.39.0",
    "@marknotes/sync": "git+https://github.com/MaxDac/marknotes-sync.git#48bdbdeda451963154d3a8defb7efc0d9a6f4cbb",
    "codemirror": "^6.0.2",
    "dompurify": "^3.3.0",
    "driver.js": "1.10.2",
    "highlight.js": "^11.11.0",
    "idb": "^8.0.3",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.3",
    "markdown-it-task-lists": "^2.1.1",
    "pdfjs-dist": "^6.4.299",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.6.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-precaching": "^7.4.0"
  }
}
